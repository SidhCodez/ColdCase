# Pipeline secrets — server-side only, never bundled into the browser.
GITHUB_TOKEN=ghp_your_token_here
GROQ_API_KEY=gsk_your_key_here
GEMINI_API_KEY=AIzaSy_your_key_here

# Optional: override the default model names.
# Defaults: llama-3.3-70b-versatile / gemini-1.5-pro
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-1.5-pro

# Web app config — only VITE_ prefixed vars reach the browser bundle.
VITE_DATA_SOURCE=static

# Worker config (P1) — only needed if running apps/worker
VITE_WORKER_URL=http://localhost:3000
ALLOWED_ORIGIN=http://localhost:3003
LIVE_MODE_ENABLED=true
